<?xml version="1.0"?>
<tryton>
    <data>
    <!-- ############# -->
    <!-- # Root Menu # -->
    <!-- ############# -->
    <menuitem name="Localisation" id="menu_library_localisation" parent="library.menu_library" sequence="1"/>
    <!-- ######## -->
    <!-- # Rooms # -->
    <!-- ######### -->
    <record model="ir.ui.view" id="room_view_form">
        <field name="model">library.localisation.room</field>
        <field name="type">form</field>
        <field name="name">room_form</field>
    </record>
    <record model="ir.ui.view" id="room_view_list">
        <field name="model">library.localisation.room</field>
        <field name="type">tree</field>
        <field name="name">room_list</field>
    </record>
    <record model="ir.action.act_window" id="act_open_room">
        <field name="name">Rooms</field>
        <field name="res_model">library.localisation.room</field>
    </record>
    <record model="ir.action.act_window.view" id="act_room_view_list">
        <field name="sequence" eval="10"/>
        <field name="view" ref="room_view_list"/>
        <field name="act_window" ref="act_open_room"/>
    </record>
    <record model="ir.action.act_window.view" id="act_room_view_form">
        <field name="sequence" eval="20"/>
        <field name="view" ref="room_view_form"/>
        <field name="act_window" ref="act_open_room"/>
    </record>
    <menuitem parent="menu_library_localisation" sequence="10" action="act_open_room" id="menu_open_room"/>
    <!-- ############# -->
    <!-- # Exemplary # -->
    <!-- ############# -->
    <record model="ir.ui.view" id="exemplary_view_form">
        <field name="model">library.book.exemplary</field>
        <field name="inherit" ref="library.exemplary_view_form"/>
        <field name="name">exemplary_form</field>
    </record>
    <record model="ir.ui.view" id="exemplary_view_list">
        <field name="model">library.book.exemplary</field>
        <field name="inherit" ref="library.exemplary_view_list"/>
        <field name="name">exemplary_list</field>
    </record>
    <record model="ir.action.act_window" id="act_open_exemplary">
        <field name="name">Exemplaries</field>
        <field name="res_model">library.book.exemplary</field>
    </record>
    <record model="ir.action.act_window.view" id="act_exemplary_view_list">
        <field name="sequence" eval="10"/>
        <field name="view" ref="exemplary_view_list"/>
        <field name="act_window" ref="act_open_exemplary"/>
    </record>
    <record model="ir.action.act_window.view" id="act_exemplary_view_form">
        <field name="sequence" eval="20"/>
        <field name="view" ref="exemplary_view_form"/>
        <field name="act_window" ref="act_open_exemplary"/>
    </record>
    <menuitem parent="menu_library_localisation" sequence="0" action="act_open_exemplary" id="menu_open_exemplary"/>
    <!-- ######## -->
    <!-- # Shelf # -->
    <!-- ######### -->
    <record model="ir.ui.view" id="shelf_view_form">
        <field name="model">library.localisation.room.shelf</field>
        <field name="type">form</field>
        <field name="name">shelf_form</field>
    </record>
    <record model="ir.ui.view" id="shelf_view_list">
        <field name="model">library.localisation.room.shelf</field>
        <field name="type">tree</field>
        <field name="name">shelf_list</field>
    </record>
    <record model="ir.action.act_window" id="act_open_shelf">
        <field name="name">Shelfs</field>
        <field name="res_model">library.localisation.room.shelf</field>
        <field name="domain" eval="[('is_store', '=', False)]" pyson="1"/>
    </record>
    <record model="ir.action.act_window.view" id="act_shelf_view_list">
        <field name="sequence" eval="10"/>
        <field name="view" ref="shelf_view_list"/>
        <field name="act_window" ref="act_open_shelf"/>
    </record>
    <record model="ir.action.act_window.view" id="act_shelf_view_form">
        <field name="sequence" eval="20"/>
        <field name="view" ref="shelf_view_form"/>
        <field name="act_window" ref="act_open_shelf"/>
    </record>
    <menuitem parent="menu_library_localisation" sequence="20" action="act_open_shelf" id="menu_open_shelf"/>
    <!-- ########### -->
    <!-- # Store # -->
    <!-- ########### -->
    <record model="ir.ui.view" id="store_view_form">
        <field name="model">library.localisation.room.shelf</field>
        <field name="type">form</field>
        <field name="name">store_form</field>
    </record>
    <record model="ir.ui.view" id="store_view_list">
        <field name="model">library.localisation.room.shelf</field>
        <field name="type">tree</field>
        <field name="name">store_list</field>
    </record>
    <record model="ir.action.act_window" id="act_open_store">
        <field name="name">Store</field>
        <field name="res_model">library.localisation.room.shelf</field>
        <field name="domain" eval="[('is_store', '=', True)]" pyson="1"/>
    </record>
    <record model="ir.action.act_window.view" id="act_store_view_form">
        <field name="sequence" eval="20"/>
        <field name="view" ref="store_view_form"/>
        <field name="act_window" ref="act_open_store"/>
    </record>
    <record model="ir.action.act_window.view" id="act_store_view_list">
        <field name="sequence" eval="10"/>
        <field name="view" ref="store_view_list"/>
        <field name="act_window" ref="act_open_store"/>
    </record>
    <menuitem parent="menu_library_localisation" sequence="30" action="act_open_store" id="menu_open_store"/>
    <!-- ############## -->
    <!-- # Quarantine # -->
    <!-- ############## -->
    <record model="ir.ui.view" id="quarantine_view_form">
        <field name="model">library.localisation.quarantine</field>
        <field name="type">form</field>
        <field name="name">quarantine_form</field>
    </record>
    <record model="ir.ui.view" id="quarantine_view_list">
        <field name="model">library.localisation.quarantine</field>
        <field name="type">tree</field>
        <field name="name">quarantine_list</field>
    </record>
    <record model="ir.action.act_window" id="act_open_quarantine">
        <field name="name">Quarantine</field>
        <field name="res_model">library.localisation.quarantine</field>
    </record>
    <record model="ir.action.act_window.view" id="act_quarantine_view_list">
        <field name="sequence" eval="10"/>
        <field name="view" ref="quarantine_view_list"/>
        <field name="act_window" ref="act_open_quarantine"/>
    </record>
    <record model="ir.action.act_window.view" id="act_quarantine_view_form">
        <field name="sequence" eval="20"/>
        <field name="view" ref="quarantine_view_form"/>
        <field name="act_window" ref="act_open_quarantine"/>
    </record>
    <menuitem parent="menu_library_localisation" sequence="40" action="act_open_quarantine" id="menu_open_quarantine"/>
    </data>
</tryton>
